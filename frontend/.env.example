# Frontend Production & Local Development Environment Variables

# Base URL for backend API requests (e.g. http://localhost:8000/api/v1 for local dev or https://api.vortexa-sustain.org/api/v1 for production)
VITE_API_URL=/api

# Firebase Client SDK Configuration (Optional)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
